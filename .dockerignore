# Dipasang di dalam image lewat composer install / npm ci di layer
# terpisah, jadi tidak perlu (dan tidak boleh) ikut disalin.
vendor
node_modules
frontend/node_modules
frontend/dist

# Riwayat Git dan metadata GitHub tidak dibutuhkan di dalam container.
.git
.gitignore
.github

# Rahasia lokal dan kunci aplikasi: JANGAN pernah ikut ke dalam image,
# sesuai peringatan slide 14 soal "menaruh rahasia di Dockerfile/image".
.env
.env.backup
frontend/.env

# Database dan cache pengembangan lokal, dibuat ulang di dalam container.
database/database.sqlite
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*.php

# Berkas non-aplikasi yang tidak perlu ikut build context.
.vscode
.idea
*.log
README.md
langkah_p4.md
langkah_p5.md
p4-files.zip
p5-files.zip
